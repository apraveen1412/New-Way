# Copy to backend/.env and fill in real values. Never commit .env.

# MongoDB connection string (used for app data and the session store)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Long random string used to sign session cookies
SESSION_SECRET=change-me

# OpenAI API key for the cloud models
OPENAI_API_KEY=

# Tavily API key for web search
TAVILY_API_KEY=
